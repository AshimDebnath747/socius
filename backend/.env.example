# Database connection (e.g., Neon Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# App secrets
JWT_SECRET=your_jwt_secret_key

# Frontend URL (used for CORS and OAuth redirect)
FEV=https://your-app.vercel.app

# Server Environment
PORT=8000
NODE_ENV=production

# Google OAuth (Optional - only if using Google login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-app.onrender.com/api/auth/google/callback
